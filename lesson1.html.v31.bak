7c8U5AfcUMh/PtTkUlsYyTxTuLU//9k=" alt="">
    <div class="robot-label">云打卡</div>
  </div>
  <div class="bottom-stats">
    <div class="progress-label">已点亮</div>
    <div class="progress-num" id="progressNum">0<span> / 33</span></div>
    <div class="progress-bar"><div class="progress-fill" id="progressBar" style="width:0%"></div></div>
    <div class="progress-tip">每点亮一盏，江面就更璀璨一分 ✦</div>
  </div>
</div>
<script>
/* 星空背景动画 */
(function(){
  var c=document.getElementById('bgCanvas'),ctx=c.getContext('2d'),w,h;
  var leaves=[];
  var lanterns=[];
  
  function resize(){
    w=c.width=innerWidth;
    h=c.height=innerHeight;
    initStars();
  }
  
  var stars=[];
  function initStars(){
    stars=[];
    for(var i=0;i<150;i++){
      stars.push({
        x:Math.random()*w,
        y:Math.random()*h,
        size:Math.random()*1.5+0.5,
        alpha:Math.random()*0.6+0.2,
        speed:Math.random()*0.008+0.003,
        dir:Math.random()>0.5?1:-1
      });
    }
  }
  function updateStars(){
    for(var i=0;i<stars.length;i++){
      var s=stars[i];
      s.alpha+=s.speed*s.dir;
      if(s.alpha>0.8){s.dir=-1;}
      if(s.alpha<0.15){s.dir=1;}
    }
  }
  
      function updateLeaves(){
    for(var i=0;i<leaves.length;i++){
      var lf=leaves[i];
      lf.x+=lf.speed;
      lf.angle+=lf.rotSpeed;
      if(lf.x>w+lf.size)lf.x=-lf.size;
      if(lf.angle>Math.PI*2)lf.angle-=Math.PI*2;
    }
  }
  
  function updateLanterns(){
    for(var i=0;i<lanterns.length;i++){
      var ln=lanterns[i];
      ln.x+=ln.speed;
      ln.wobble+=ln.wobbleSpeed;
      if(ln.x>w+ln.size)ln.x=-ln.size;
    }
  }
  
  function draw(){
    // 深蓝星空背景
    var grad=ctx.createLinearGradient(0,0,0,h);
    grad.addColorStop(0,'#0e1a35');
    grad.addColorStop(0.5,'#0a1228');
    grad.addColorStop(1,'#060d1e');
    ctx.fillStyle=grad;
    ctx.fillRect(0,0,w,h);
    
    // 星星闪烁
    updateStars();
    for(var i=0;i<stars.length;i++){
      var s=stars[i];
      ctx.beginPath();
      ctx.arc(s.x,s.y,s.size,0,Math.PI*2);
      ctx.fillStyle='rgba(255,255,255,'+s.alpha+')';
      ctx.fill();
    }
    
    requestAnimationFrame(draw);
  }
  
  resize();
  draw();
  addEventListener('resize',resize);
})();

var total=33,myName='',myLitIndex=-1,pendingIdx=-1,litMap={},adminMode=false;

/* ========== 椭圆蜂巢计算 ========== */
var R=Math.max(36,Math.min(44,Math.floor(innerWidth/9.5))),sqrt3=Math.sqrt(3);
var savedCells=[],savedGridR=R,savedOffX=0,savedOffY=0,savedMinX=0,savedMinY=0,savedMaxX=0,savedMaxY=0;
var stepX=sqrt3*R, stepY=1.5*R, halfStep=stepX/2;

function ovalVal(x,y){var a=3.2,b=3.6;return Math.pow(x/a,2)+Math.pow(y/b,2)-1}
function findScale(){
  var lo=20,hi=300;
  for(var i=0;i<100;i++){var mid=(lo+hi)/2,cnt=countInside(mid);if(cnt<total)lo=mid;else hi=mid}
  return hi;
}
function countInside(s){
  var n=0;
  for(var row=-12;row<=12;row++)for(var col=-12;col<=12;col++){
    var px=col*stepX+(Math.abs(row)%2===1?halfStep:0),py=row*stepY;
    if(ovalVal(px/s,-py/s)<=0)n++;
  }
  return n;
}
function getCells(s){
  var cells=[];
  for(var row=-12;row<=12;row++)for(var col=-12;col<=12;col++){
    var px=col*stepX+(Math.abs(row)%2===1?halfStep:0),py=row*stepY;
    var v=ovalVal(px/s,-py/s);
    if(v<=0)cells.push({row:row,col:col,px:px,py:py,v:v});
  }
  return cells;
}

/* 星空六边形SVG - 简洁科技风 */
function hexSVG(lit,disp,idx){
  // SVG六边形R跟随网格R，保证紧凑不重叠
  var R=Math.max(32,Math.min(40,Math.floor(savedGridR||39)*0.95));
  var w=R*2+4,h=R*1.732+4;
  var cx=w/2,cy=h/2;
  var pts=[];
  for(var i=0;i<6;i++){
    var ang=Math.PI/6+i*Math.PI/3;
    pts.push([cx+R*Math.cos(ang),cy+R*Math.sin(ang)].map(function(x){return x.toFixed(1)}).join(','));
  }
  var p=pts.join(' ');
  // 字体大小自适应
  var fs=Math.max(10,Math.round(R*0.35));
  if(disp.length>6)fs=Math.max(9,Math.round(R*0.28));
  if(lit){
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" xmlns="http://www.w3.org/2000/svg">'+
      '<defs><linearGradient id="lg'+idx+'" x1="0%" y1="0%" x2="100%" y2="100%">'+
      '<stop offset="0%" stop-color="#5a4820"/><stop offset="50%" stop-color="#4a3a10"/><stop offset="100%" stop-color="#3a2e08"/>'+
      '</linearGradient></defs>'+
      '<polygon points="'+p+'" fill="url(#lg'+idx+')" stroke="#DAA520" stroke-width="1.5" '+
      'style="filter:drop-shadow(0 0 6px rgba(218,165,32,0.4))"/>'+
      '<text x="'+cx+'" y="'+(cy+1)+'" text-anchor="middle" dominant-baseline="middle" '+
      'fill="#FFD700" font-size="'+fs+'" font-weight="700">'+disp+'</text>'+
      '</svg>';
  } else {
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" xmlns="http://www.w3.org/2000/svg">'+
      '<polygon points="'+p+'" fill="rgba(30,45,80,0.7)" stroke="rgba(80,120,180,0.4)" stroke-width="1.2"/>'+
      '</svg>';
  }
}

/* 昵称显示：显示完整名字 */
function cuteName(n){
  if(!n)return'';
  return n;
}

/* 粒子爆发 */
function burstParticles(el){
  var rect=el.getBoundingClientRect();
  var ox=rect.left+rect.width/2, oy=rect.top+rect.height/2;
  var colors=['#FFD700','#E6B800','#FFD700','#FFB347','#ffffff'];
  for(var i=0;i<12;i++){
    var p=document.createElement('div');p.className='particle';
    var angle=Math.PI*2*i/12, dist=30+Math.random()*25;
    var dx=Math.cos(angle)*dist, dy=Math.sin(angle)*dist;
    var size=2+Math.random()*3;
    p.style.cssText='left:'+ox+'px;top:'+oy+'px;width:'+size+'px;height:'+size+'px;background:'+colors[i%colors.length]+';position:fixed;transition:all 0.6s cubic-bezier(0.25,0.46,0.45,0.94);opacity:1;';
    document.body.appendChild(p);
    (function(el,dx,dy){requestAnimationFrame(function(){el.style.transform='translate('+dx+'px,'+dy+'px)';el.style.opacity='0'})})(p,dx,dy);
    (function(el){setTimeout(function(){el.remove()},700)})(p);
  }
}

function buildGrid(){
  total=parseInt(document.getElementById('totalInput').value)||33;
  total=Math.max(1,Math.min(99,total));
  var scale=findScale();
  var cells=getCells(scale);
  if(cells.length>total){cells.sort(function(a,b){return b.v-a.v});cells=cells.slice(cells.length-total)}
  cells.sort(function(a,b){return a.py!==b.py?a.py-b.py:a.px-b.px});
  total=cells.length;
  document.getElementById('totalInput').value=total;
  var minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  for(var i=0;i<cells.length;i++){
    if(cells[i].px<minX)minX=cells[i].px;if(cells[i].px>maxX)maxX=cells[i].px;
    if(cells[i].py<minY)minY=cells[i].py;if(cells[i].py>maxY)maxY=cells[i].py;
  }
  var offX=-minX+10, offY=-minY+10;
  var gridW=maxX-minX+sqrt3*R+20, gridH=maxY-minY+2*R+20;
  savedCells=cells.slice();savedGridR=R;savedOffX=offX;savedOffY=offY;savedMinX=minX;savedMinY=minY;savedMaxX=maxX;savedMaxY=maxY;
  var grid=document.getElementById('heartGrid');grid.innerHTML='';
  grid.style.width=gridW+'px';grid.style.height=gridH+'px';
  var glow=document.createElement('div');glow.className='heart-glow';grid.appendChild(glow);
  for(var i=0;i<cells.length;i++){
    var isLit=litMap.hasOwnProperty(i), isMine=(myLitIndex===i);
    var el=document.createElement('div');
    var cls='hex';if(isLit)cls+=' lit';else cls+=' available';if(isLit&&!isMine)cls+=' taken';
    el.className=cls;
    el.style.left=(cells[i].px+offX)+'px';el.style.top=(cells[i].py+offY)+'px';
    el.setAttribute('data-index',i);
    el.innerHTML=hexSVG(isLit,isLit?cuteName(litMap[i]):'',i);
    (function(idx){el.onclick=function(){onCellClick(idx)}})(i);
    grid.appendChild(el);
  }
  updateProgress();
}

var _clickLock=false;
function onCellClick(idx){
  if(_clickLock)return;_clickLock=true;setTimeout(function(){_clickLock=false},500);
  /* 管理员模式：按灭 */
  if(adminMode&&litMap.hasOwnProperty(idx)){
    var nm=litMap[idx];if(confirm('按灭 '+nm+' 的模块？')){adminUnlightByName(nm)}return;
  }
  /* 管理员模式：代点亮 */
  if(adminMode&&!litMap.hasOwnProperty(idx)){
    var aname=prompt('代点亮 - 输入学员昵称：');
    if(aname&&aname.trim()){adminLightFor(idx,aname.trim())}return;
  }
  if(myLitIndex>=0){if(myLitIndex===idx)return;showAlready();return}
  if(litMap.hasOwnProperty(idx))return;
  pendingIdx=idx;
  document.getElementById('nameInput').value=myName||'';
  document.getElementById('nameError').style.display='none';
  document.getElementById('nameModal').classList.add('show');
  setTimeout(function(){document.getElementById('nameInput').focus()},100);
}
function confirmName(){
  var name=document.getElementById('nameInput').value.trim(),err=document.getElementById('nameError');
  if(!name){err.textContent='请输入昵称';err.style.display='block';return}
  myName=name;litMap[pendingIdx]=myName;myLitIndex=pendingIdx;saveState();
  document.getElementById('nameModal').classList.remove('show');
  buildGrid();
  var hxs=document.querySelectorAll('.hex');
  for(var i=0;i<hxs.length;i++){
    if(parseInt(hxs[i].getAttribute('data-index'))===pendingIdx){
      hxs[i].classList.add('just-lit');
      burstParticles(hxs[i]);
      (function(el){setTimeout(function(){el.classList.remove('just-lit')},600)})(hxs[i]);
    }
  }
  showSuccess();
  var litCount=0;for(var k in litMap)if(litMap.hasOwnProperty(k))litCount++;
  if(litCount>=total){setTimeout(function(){showCelebration()},1500)}
}
function cancelName(){document.getElementById('nameModal').classList.remove('show');pendingIdx=-1}
document.getElementById('nameInput').addEventListener('keyup',function(e){if(e.key==='Enter')confirmName()});
function showSuccess(){var t=document.getElementById('successToast');t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2200)}
function showAlready(){var t=document.getElementById('alreadyToast');t.classList.add('show');setTimeout(function(){t.classList.remove('show')},1500)}
function showCelebration(){document.getElementById('celebration').classList.add('show')}
function closeCelebration(){document.getElementById('celebration').classList.remove('show')}

function updateProgress(){
  var n=0;for(var k in litMap)if(litMap.hasOwnProperty(k))n++;
  var pct=Math.round(n/total*100);
  document.getElementById('progressNum').innerHTML=n+'<span> / '+total+'</span>';
  document.getElementById('progressBar').style.width=pct+'%';
  var ratio=Math.min(n/total,1);
  var rv=document.getElementById('robotImg');
  if(rv)rv.style.filter='drop-shadow(0 0 '+(6+10*ratio)+'px rgba(100,180,255,'+(0.25+0.35*ratio)+'))';
  var gw=document.querySelector('.heart-glow');
  if(gw)gw.style.background='radial-gradient(ellipse,rgba(80,120,200,'+(0.18+0.15*ratio)+') 0%,rgba(100,80,220,0.06) 40%,transparent 70%)';
}

/* ========== 管理员功能 ========== */
var adminOpen=false,adminUnlocked=false;
function tryAdmin(){
  if(adminUnlocked){adminOpen=!adminOpen;document.getElementById('adminPanel').classList.toggle('show',adminOpen);return}
  var pwd=prompt('管理密码：');
  if(pwd==='xiaoxuan2026'){
    adminUnlocked=true;adminMode=true;
    document.querySelector('.admin-fab').textContent='⚙';
    adminOpen=true;
    document.getElementById('adminPanel').classList.add('show');
    loadTitleInputs();
  }else if(pwd!==null){
    alert('密码错误');
  }
}

function adminUnlight(){
  var name=document.getElementById('unlightName').value.trim();
  if(!name){alert('请输入昵称');return}
  adminUnlightByName(name);
}

function adminUnlightByName(name){
  var found=false;
  for(var k in litMap){
    if(litMap[k]===name){
      delete litMap[k];found=true;
      if(myLitIndex===parseInt(k))myLitIndex=-1;
    }
  }
  if(!found){alert('未找到该昵称');return}
  saveState();buildGrid();
  document.getElementById('unlightName').value='';
}

function adminLightFor(idx,name){
  /* 检查昵称是否已存在 */
  for(var k in litMap){
    if(litMap[k]===name){alert('该昵称已点亮');return}
  }
  litMap[idx]=name;
  saveState();buildGrid();
}

function adminRandom(){
  var cnt=Math.floor(total*(0.3+Math.random()*0.4));litMap={};
  var idxs=[];for(var i=0;i<total;i++)idxs.push(i);
  for(var i=idxs.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var tmp=idxs[i];idxs[i]=idxs[j];idxs[j]=tmp}
  var names=['小雨','阿杰','小王','晓晓','大刘','小陈','阿明','小林','晓峰','小赵','阿文','小杨','晓燕','大海','小吴','阿豪','小苏','晓龙','小何','阿飞','小郑','小罗','阿东','小梁','晓华','小韩','阿龙','小周','晓雪','小孙','阿南','小黄','小吕'];
  for(var i=0;i<cnt;i++)litMap[idxs[i]]=names[idxs[i]%names.length];
  myLitIndex=-1;saveState();buildGrid();
}
function adminFull(){
  litMap={};var names=['小雨','阿杰','小王','晓晓','大刘','小陈','阿明','小林','晓峰','小赵','阿文','小杨','晓燕','大海','小吴','阿豪','小苏','晓龙','小何','阿飞','小郑','小罗','阿东','小梁','晓华','小韩','阿龙','小周','晓雪','小孙','阿南','小黄','小吕'];
  for(var i=0;i<total;i++)litMap[i]=names[i%names.length];
  myLitIndex=-1;saveState();buildGrid();
  setTimeout(function(){showCelebration()},800);
}
function adminReset(){
  litMap={};localStorage.removeItem('sc1_data');localStorage.removeItem('sc1_myIdx');
  localStorage.removeItem('sc1_title');localStorage.removeItem('sc1_subtitle');
  myLitIndex=-1;
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  mt.textContent='AI编程课-1班';st.textContent='第1课 编程入门';
  loadTitleInputs();
  buildGrid();
}

function saveTitle(){
  var t=document.getElementById('titleInput').value,st=document.getElementById('subtitleInput').value;
  document.getElementById('mainTitle').textContent=t;
  document.getElementById('subTitle').textContent=st;
  localStorage.setItem('sc1_title',t);
  localStorage.setItem('sc1_subtitle',st);
  history.replaceState(null,'',location.pathname+'?t='+encodeURIComponent(t)+'&st='+encodeURIComponent(st));
}

function loadTitleInputs(){
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  document.getElementById('titleInput').value=mt.textContent;
  document.getElementById('subtitleInput').value=st.textContent;
}

function setTitleSize(v){
  document.getElementById('mainTitle').style.fontSize=v+'px';
  document.getElementById('subTitle').style.fontSize=Math.round(v*0.55)+'px';
}

function saveState(){
  localStorage.setItem('sc1_data',JSON.stringify(litMap));
  if(myLitIndex>=0)localStorage.setItem('sc1_myIdx',String(myLitIndex));
  // Sync to server
  try{
    var base=detectApiBase();
    if(base){
      var xhr=new XMLHttpRequest();
      xhr.open('POST',base+'/light',true);
      xhr.setRequestHeader('Content-Type','application/json');
      // Send all cells one by one would be too many requests
      // Instead, send full state via a custom endpoint
      // We'll add a /sync endpoint approach
      syncToServer(base);
    }
  }catch(e){}
}
function detectApiBase(){
  if(location.hostname.indexOf('trycloudflare')>=0||location.hostname==='localhost'||location.hostname==='127.0.0.1'){
    return '/api/lesson/1';
  }
  return 'https://filling-abs-prozac-alive.trycloudflare.com/api/lesson/1';
}
var _serverStateLoaded=false;
function loadState(){
  var s=localStorage.getItem('sc1_data');if(s){try{litMap=JSON.parse(s)}catch(e){litMap={}}}
  var mi=localStorage.getItem('sc1_myIdx');if(mi!==null)myLitIndex=parseInt(mi);
  // Load from server (async, will update display after)
  var base=detectApiBase();
  if(base){
    var xhr=new XMLHttpRequest();
    xhr.open('GET',base+'/state',true);
    xhr.onload=function(){
      if(xhr.status===200){
        try{
          var sv=JSON.parse(xhr.responseText);
          if(sv.cells&&Object.keys(sv.cells).length>0){
            // Server data wins - merge: server cells + any local-only cells
            var merged={};
            for(var k in sv.cells)merged[k]=sv.cells[k];
            for(var k in litMap){if(!merged[k])merged[k]=litMap[k]}
            litMap=merged;
            localStorage.setItem('sc1_data',JSON.stringify(litMap));
            _serverStateLoaded=true;
            buildGrid();
          }
        }catch(e){}
      }
    };
    xhr.onerror=function(){};
    xhr.send();
  }
}
function syncToServer(base){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',base+'/sync',true);
  xhr.setRequestHeader('Content-Type','application/json');
  xhr.send(JSON.stringify({cells:litMap,order:typeof order!=='undefined'?order:[]}));
}

/* 标题长按编辑 */
(function(){
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  var qp=new URLSearchParams(location.search);
  var smt=qp.get('t')||localStorage.getItem('sc1_title'),sst=qp.get('st')||localStorage.getItem('sc1_subtitle');
  if(smt)mt.textContent=smt;if(sst)st.textContent=sst;
  function bindLongPress(el,key){
    var timer=null;
    el.addEventListener('pointerdown',function(e){
      timer=setTimeout(function(){
        el.contentEditable='true';
        el.style.borderBottomColor='rgba(255,215,0,0.4)';
        el.focus();
        var range=document.createRange();range.selectNodeContents(el);
        var sel=window.getSelection();sel.removeAllRanges();sel.addRange(range);
      },800);
    });
    el.addEventListener('pointerup',function(){clearTimeout(timer)});
    el.addEventListener('pointerleave',function(){clearTimeout(timer)});
    el.addEventListener('blur',function(){
      el.contentEditable='false';
      el.style.borderBottomColor='transparent';
      localStorage.setItem(key,el.textContent);
      var mt2=document.getElementById('mainTitle'),st2=document.getElementById('subTitle');
      history.replaceState(null,'',location.pathname+'?t='+encodeURIComponent(mt2.textContent)+'&st='+encodeURIComponent(st2.textContent));
    });
  }
  bindLongPress(mt,'sc1_title');
  bindLongPress(st,'sc1_subtitle');
})();

/* ========== 分享图片生成 ========== */
if(!CanvasRenderingContext2D.prototype.roundRect){CanvasRenderingContext2D.prototype.roundRect=function(x,y,w,h,r){r=Math.min(r,w/2,h/2);this.moveTo(x+r,y);this.arcTo(x+w,y,x+w,y+h,r);this.arcTo(x+w,y+h,x,y+h,r);this.arcTo(x,y+h,x,y,r);this.arcTo(x,y,x+w,y,r);this.closePath()}}
function shareImage(){
  var c=document.createElement('canvas');var W=750,H=1334;c.width=W;c.height=H;var ctx=c.getContext('2d');
  /* 星空背景 */
  var grad=ctx.createLinearGradient(0,0,0,H);grad.addColorStop(0,'#0e1a35');grad.addColorStop(0.5,'#0a1228');grad.addColorStop(1,'#060d1e');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
  /* 水波纹 */
  /* 星星 */
  for(var i=0;i<280;i++){ctx.beginPath();ctx.arc(Math.random()*W,Math.random()*H,Math.random()*3+0.5,0,Math.PI*2);ctx.fillStyle='rgba(220,235,255,'+(Math.random()*0.6+0.3)+')';ctx.fill()}
  /* 暗角 */
  var vg=ctx.createRadialGradient(W/2,H/2,200,W/2,H/2,700);vg.addColorStop(0,'transparent');vg.addColorStop(1,'rgba(10,20,35,0.3)');ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  /* 标题 */
  ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='top';ctx.font='bold 52px -apple-system,sans-serif';ctx.fillText(document.getElementById('mainTitle').textContent,W/2,60);
  ctx.font='22px -apple-system,sans-serif';ctx.fillStyle='rgba(200,210,220,0.5)';ctx.fillText(document.getElementById('subTitle').textContent,W/2,125);
  /* 绘制心形格子 - 复用页面buildGrid的布局，保证打卡位置一致 */
  var gridW=savedMaxX-savedMinX+sqrt3*savedGridR+20,gridH=savedMaxY-savedMinY+2*savedGridR+20;
  var bottomStart=H-480;
  var maxGridH=bottomStart-180;
  var sf=Math.min((W-40)/gridW,maxGridH/gridH);
  var cR=savedGridR*sf;
  var marginX=(W-gridW*sf)/2,topY=180;
  /* 椭圆光晕 */
  var heartCY=topY+gridH*sf/2;
  var hg=ctx.createRadialGradient(W/2,heartCY,30,W/2,heartCY,Math.max(200,gridH*sf*0.5));hg.addColorStop(0,'rgba(100,80,220,0.35)');hg.addColorStop(1,'transparent');ctx.fillStyle=hg;ctx.fillRect(0,150,W,gridH*sf+100);
  for(var i=0;i<savedCells.length;i++){
    var pageCX=savedCells[i].px+savedOffX+sqrt3*savedGridR/2;
    var pageCY=savedCells[i].py+savedOffY+savedGridR;
    var cx2=marginX+pageCX*sf,cy2=topY+pageCY*sf;var isLit=litMap.hasOwnProperty(i);var pts=[];
    for(var j=0;j<6;j++){var angle=Math.PI/180*(60*j-30);pts.push(cx2+cR*Math.cos(angle));pts.push(cy2+cR*Math.sin(angle))}
    ctx.beginPath();ctx.moveTo(pts[0],pts[1]);for(var j=1;j<6;j++)ctx.lineTo(pts[j*2],pts[j*2+1]);ctx.closePath();
    if(isLit){
      var g=ctx.createLinearGradient(cx2,cy2-cR,cx2,cy2+cR);g.addColorStop(0,'#5a4820');g.addColorStop(0.5,'#4a3a10');g.addColorStop(1,'#3a2e08');ctx.fillStyle=g;ctx.fill();ctx.strokeStyle='rgba(218,165,32,0.8)';ctx.lineWidth=2;ctx.stroke();
      var nm=cuteName(litMap[i]);if(nm){ctx.fillStyle='#FFD700';ctx.font='bold '+Math.max(11,cR*0.4).toFixed(0)+'px -apple-system,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(nm,cx2,cy2)}
    }else{
      var g=ctx.createLinearGradient(cx2,cy2-cR,cx2,cy2+cR);g.addColorStop(0,'rgba(30,45,80,0.7)');g.addColorStop(0.5,'rgba(25,40,70,0.6)');g.addColorStop(1,'rgba(20,32,55,0.5)');ctx.fillStyle=g;ctx.fill();ctx.strokeStyle='rgba(80,120,180,0.5)';ctx.lineWidth=2;ctx.stroke()
    }
  }
  /* 机器人 */
  var rH=100;
  var robotImg=document.getElementById('robotImg');if(robotImg&&robotImg.complete&&robotImg.naturalWidth>0){var rW=120,rH2=120*robotImg.naturalHeight/robotImg.naturalWidth;ctx.drawImage(robotImg,W/2-rW/2,bottomStart-10,rW,rH2);rH=rH2}
  ctx.fillStyle='rgba(255,215,0,0.35)';ctx.font='14px -apple-system,sans-serif';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('云打卡',W/2,bottomStart+rH+8);
  /* 进度 */
  var n=0;for(var k in litMap)if(litMap.hasOwnProperty(k))n++;
  ctx.fillStyle='rgba(255,255,255,0.5)';ctx.font='16px -apple-system,sans-serif';ctx.fillText('已点亮',W/2,bottomStart+rH+28);
  ctx.fillStyle='#FFD700';ctx.font='bold 40px -apple-system,sans-serif';ctx.fillText(n+' / '+total,W/2,bottomStart+rH+62);
  /* 进度条 */
  var barW=260,barH=8,barX=(W-barW)/2,barY=bottomStart+rH+114;ctx.fillStyle='rgba(255,255,255,0.05)';ctx.beginPath();ctx.roundRect(barX,barY,barW,barH,3);ctx.fill();
  var pct=n/total;if(pct>0){var pg=ctx.createLinearGradient(barX,0,barX+barW*pct,0);pg.addColorStop(0,'#FFD700');pg.addColorStop(0.5,'#FFD700');pg.addColorStop(1,'#E74C3C');ctx.fillStyle=pg;ctx.beginPath();ctx.roundRect(barX,barY,barW*pct,barH,3);ctx.fill()}
  /* 二维码 */
  try{
    var pageUrl='https://filling-abs-prozac-alive.trycloudflare.com/lesson1.html';
    var qr=qrcode(0,'M');qr.addData(pageUrl);qr.make();var mc=qr.getModuleCount();var qs=3,qm=6,qx=W/2-(mc*qs+qm*2)/2,qy=H-60-(mc*qs+qm*2);
    ctx.fillStyle='rgba(255,255,255,0.95)';ctx.beginPath();ctx.roundRect(qx-4,qy-4,(mc*qs+qm*2)+8,(mc*qs+qm*2)+8,6);ctx.fill();
    for(var r=0;r<mc;r++)for(var c3=0;c3<mc;c3++){ctx.fillStyle=qr.isDark(r,c3)?'#0e2238':'#fff';ctx.fillRect(qx+qm+c3*qs,qy+qm+r*qs,qs,qs)}
    ctx.fillStyle='rgba(255,215,0,0.45)';ctx.font='14px -apple-system,sans-serif';ctx.fillText('扫码加入打卡',W/2,qy-20);
  }catch(e){console.log('qr error',e)}
  var dataUrl=c.toDataURL('image/png');var ov=document.createElement('div');ov.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center';var img=document.createElement('img');img.src=dataUrl;img.style.cssText='max-width:90%;max-height:75vh;border-radius:8px';var tip=document.createElement('div');tip.style.cssText='color:#fff;font-size:16px;margin-top:16px;opacity:0.7';tip.textContent='\u957f\u6309\u56fe\u7247\u4fdd\u5b58 \u2192 \u53d1\u5230\u7fa4\u804a';var btn=document.createElement('button');btn.style.cssText='margin-top:12px;padding:10px 30px;border:none;border-radius:20px;background:linear-gradient(135deg,#FFD700,#FFD700);color:#000;font-size:16px;font-weight:bold';btn.textContent='\u5173\u95ed';btn.onclick=function(){ov.remove()};ov.appendChild(img);ov.appendChild(tip);ov.appendChild(btn);ov.onclick=function(e){if(e.target===ov)ov.remove()};document.body.appendChild(ov);
}

loadState();buildGrid();
</script>
</body>
</html>