</head>
<body>
<canvas id="bgCanvas"></canvas>
<div class="vignette"></div>
<div class="modal-overlay" id="nameModal"><div class="modal-card"><div class="label">✦ 输入昵称，点亮你的灯</div><input type="text" id="nameInput" placeholder="你的昵称" maxlength="8"><div class="error" id="nameError"></div><div class="btns"><button class="btn-cancel" onclick="cancelName()">取消</button><button class="btn-ok" onclick="confirmName()">点亮 ✦</button></div></div></div>
<div class="toast" id="successToast"><div class="icon">🐉</div><div class="msg">打卡成功！</div><div class="sub">第1课 编程入门</div></div>
<div class="already-toast" id="alreadyToast"><div class="msg">你已经点亮过了哦 🎋</div></div>
<div class="celebration" id="celebration"><div class="celebration-card"><div class="icon">🎆</div><div class="title">灯火辉煌！</div><div class="desc">每一盏灯都在路上，期待满江璀璨的那一天</div><button class="close-btn" onclick="closeCelebration()">继续闪耀 ✦</button></div></div>

<div class="admin-fab" title="管理面板" onclick="tryAdmin()">⚙</div>
<div class="admin-panel" id="adminPanel"><label>数</label><input type="number" id="totalInput" value="33" min="1" max="99"><button class="primary" onclick="adminRandom()">模拟</button><button onclick="adminFull()">满员</button><button onclick="adminReset()">重置</button><br><label>主标题</label><input type="text" id="titleInput" style="width:80px" onchange="saveTitle()"><label>副标题</label><input type="text" id="subtitleInput" style="width:80px" onchange="saveTitle()"><br><label>按灭</label><input type="text" id="unlightName" placeholder="输入昵称" style="width:60px"><button onclick="adminUnlight()">按灭</button><label style="margin-left:4px">字号</label><input type="number" id="titleSizeInput" value="20" min="12" max="36" style="width:32px" onchange="setTitleSize(this.value)"></div>
<div class="scene">
  <button class="share-btn" onclick="shareImage()">📷分享</button>
  <div class="header"><h1 contenteditable="false" id="mainTitle" style="outline:none;min-width:60px;transition:border 0.3s;border-bottom:2px solid transparent">AI编程课-1班</h1><div class="sub" contenteditable="false" id="subTitle" style="outline:none;min-width:60px;transition:border 0.3s;border-bottom:1px solid transparent">第1课 编程入门</div></div>
  <div class="heart-area">
    <div class="heart-grid" id="heartGrid"></div>
  </div>
  <div class="robot-section">
    <img class="robot-img" id="robotImg" src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/4QLoaHR0cDovL25zLmFkb2JlLmNvbS94YXAvMS4wLwA8P3ht
