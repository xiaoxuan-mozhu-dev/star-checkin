</head>
<body>
<canvas id="bgCanvas"></canvas>
<div class="vignette"></div>
<div class="modal-overlay" id="nameModal"><div class="modal-card"><div class="label">✦ 输入昵称，点亮你的灯</div><input type="text" id="nameInput" placeholder="你的昵称" maxlength="8"><div class="error" id="nameError"></div><div class="btns"><button class="btn-cancel" onclick="cancelName()">取消</button><button class="btn-ok" onclick="confirmName()">点亮 ✦</button></div></div></div>
<div class="toast" id="successToast"><div class="icon">🦞</div><div class="msg">打卡成功！</div><div class="sub">智锋所指，所向披靡 ✦</div></div>
<div class="already-toast" id="alreadyToast"><div class="msg">你已经点亮过了哦 🎋</div></div>
<div class="celebration" id="celebration"><div class="celebration-card"><div class="icon">🎆</div><div class="title">Agent启航！</div><div class="desc">每一个Agent都已激活，期待全员Workbuddy的那一天</div><button class="close-btn" onclick="closeCelebration()">继续闪耀 ✦</button></div></div>

<div class="admin-fab" title="管理面板" onclick="tryAdmin()">⚙</div>
<div class="admin-panel" id="adminPanel"><label>数</label><input type="number" id="totalInput" value="35" min="1" max="99"><button class="primary" onclick="adminRandom()">模拟</button><button onclick="adminFull()">满员</button><button onclick="adminReset()">重置</button><br><label>主标题</label><input type="text" id="titleInput" style="width:80px" onchange="saveTitle()"><label>副标题</label><input type="text" id="subtitleInput" style="width:80px" onchange="saveTitle()"><br><label>按灭</label><input type="text" id="unlightName" placeholder="输入昵称" style="width:60px"><button onclick="adminUnlight()">按灭</button><label style="margin-left:4px">字号</label><input type="number" id="titleSizeInput" value="20" min="12" max="36" style="width:32px" onchange="setTitleSize(this.value)"></div>
<div class="scene">
  <button class="share-btn" onclick="shareImage()">📷分享</button>
  <div class="header"><h1 contenteditable="false" id="mainTitle" style="outline:none;min-width:60px;transition:border 0.3s;border-bottom:2px solid transparent">AI编程课</h1><div class="sub" contenteditable="false" id="subTitle" style="outline:none;min-width:60px;transition:border 0.3s;border-bottom:1px solid transparent">第4课 龙虾Agent打卡</div></div>
  <div class="heart-area">
    <div class="heart-grid" id="heartGrid"></div>
  </div>
  <div class="robot-section">
    <div class="robot-img-wrap"><img class="robot-img" id="robotImg" crossorigin="anonymous" src="data:image/png;base64," alt=""><div class="robot-guard"></div></div>
    <div class="robot-label">Workbuddy守护者</div>
  </div>
  <div class="bottom-stats">
    <div class="progress-label">已点亮</div>
    <div class="progress-num" id="progressNum">0<span> / 33</span></div>
    <div class="progress-bar"><div class="progress-fill" id="progressBar" style="width:0%"></div></div>
    <div class="progress-tip">每激活一个Agent，龙虾Agent之力就更进一步 ✦</div>
  </div>
</div>
<script>

  // 版本标记 - 用于后续更新时判断缓存
  localStorage.setItem('sc4_ver', 'v20260626.1');

/* 火花余烬背景动画 - 龙虾Agent主题 */
(function(){
  var c=document.getElementById('bgCanvas'),ctx=c.getContext('2d'),w,h;
  var sparks=[];
  var embers=[];
  
  function resize(){
    w=c.width=innerWidth;
    h=c.height=innerHeight;
    initSparks();
    initEmbers();
  }
  
  function initSparks(){
    sparks=[];
    for(var i=0;i<30;i++){
      sparks.push({
        x:Math.random()*w,
        y:Math.random()*h,
        size:1+Math.random()*3,
        speedY:-(0.3+Math.random()*0.6),
        speedX:(Math.random()-0.5)*0.3,
        alpha:0.2+Math.random()*0.4,
        life:Math.random(),
        decay:0.002+Math.random()*0.003,
        hue:200+Math.random()*40
      });
    }
  }
  
  function initEmbers(){
    embers=[];
    for(var i=0;i<8;i++){
      embers.push({
        x:Math.random()*w,
        y:h*0.5+Math.random()*h*0.5,
        size:4+Math.random()*8,
        speedY:-(0.1+Math.random()*0.2),
        speedX:(Math.random()-0.5)*0.15,
        alpha:0.1+Math.random()*0.15,
        pulse:Math.random()*Math.PI*2,
        pulseSpeed:0.02+Math.random()*0.03
      });
    }
  }
  
  function drawEmber(yPos,amplitude,frequency,color,alpha){
    ctx.beginPath();
    ctx.moveTo(0,yPos);
    for(var x=0;x<=w;x+=5){
      var y=yPos+Math.sin(x*frequency+Date.now()*0.001)*amplitude;
      ctx.lineTo(x,y);
    }
    ctx.lineTo(w,h);
    ctx.lineTo(0,h);
    ctx.closePath();
    ctx.fillStyle=color.replace('{alpha}',alpha);
    ctx.fill();
  }
  
  function drawSpark(sp){
    ctx.save();
    ctx.globalAlpha=sp.alpha*sp.life;
    ctx.beginPath();
    ctx.arc(sp.x,sp.y,sp.size,0,Math.PI*2);
    var r=Math.floor(sp.hue*0.3);
    var g=Math.floor(sp.hue*0.8);
    var b=200+Math.floor((sp.hue-200)*1.5);
    ctx.fillStyle='rgba('+r+','+g+','+b+',1)';
    ctx.shadowColor='rgba('+r+','+g+','+b+',0.8)';
    ctx.shadowBlur=sp.size*3;
    ctx.fill();
    ctx.restore();
  }
  
  function drawEmberGlow(em){
    ctx.save();
    ctx.translate(em.x,em.y);
    var pulseAlpha=em.alpha*(0.7+0.3*Math.sin(em.pulse));
    var grad=ctx.createRadialGradient(0,0,0,0,0,em.size);
    grad.addColorStop(0,'rgba(255,100,80,'+pulseAlpha+')');
    grad.addColorStop(0.4,'rgba(200,50,60,'+pulseAlpha*0.6+')');
    grad.addColorStop(1,'rgba(120,20,40,0)');
    ctx.fillStyle=grad;
    ctx.beginPath();
    ctx.arc(0,0,em.size,0,Math.PI*2);
    ctx.fill();
    ctx.restore();
  }
  
  function updateSparks(){
    for(var i=0;i<sparks.length;i++){
      var sp=sparks[i];
      sp.x+=sp.speedX;
      sp.y+=sp.speedY;
      sp.life-=sp.decay;
      if(sp.life<=0||sp.y<-10){
        sp.x=Math.random()*w;
        sp.y=h+10;
        sp.life=0.6+Math.random()*0.4;
        sp.alpha=0.2+Math.random()*0.4;
      }
    }
  }
  
  function updateEmbers(){
    for(var i=0;i<embers.length;i++){
      var em=embers[i];
      em.x+=em.speedX+Math.sin(em.pulse)*0.2;
      em.y+=em.speedY;
      em.pulse+=em.pulseSpeed;
      if(em.y<-em.size*2){
        em.x=Math.random()*w;
        em.y=h+em.size;
      }
    }
  }
  
  function draw(){
    var grad=ctx.createLinearGradient(0,0,0,h);
    grad.addColorStop(0,'#0a0e1a');
    grad.addColorStop(0.3,'#101828');
    grad.addColorStop(0.7,'#152040');
    grad.addColorStop(1,'#0a1430');
    ctx.fillStyle=grad;
    ctx.fillRect(0,0,w,h);
    
    var waterY=h*0.65;
    drawEmber(waterY,6,0.006,'rgba(40,100,200,{alpha})',0.1);
    drawEmber(waterY+15,4,0.010,'rgba(60,140,230,{alpha})',0.08);
    drawEmber(waterY+30,3,0.013,'rgba(80,170,255,{alpha})',0.05);
    
    updateSparks();
    for(var i=0;i<sparks.length;i++){
      drawSpark(sparks[i]);
    }
    
    updateEmbers();
    for(var i=0;i<embers.length;i++){
      drawEmberGlow(embers[i]);
    }
    
    requestAnimationFrame(draw);
  }
  
  resize();
  draw();
  addEventListener('resize',resize);
})();

var total=34,myName='',myLitIndex=-1,pendingIdx=-1,litMap={},adminMode=false;

/* ========== 钻石形布局（龙虾能量核心） ========== */
var R=Math.max(14,Math.min(26,Math.floor(innerWidth/18)));
var savedCells=[],savedGridR=R,savedOffX=0,savedOffY=0,savedMinX=0,savedMinY=0,savedMaxX=0,savedMaxY=0;
var stepX=R*2.1, stepY=R*2.1;

function heartVal(x,y){return 0}
function findScale(){
  return 1;
}
function countInside(s){
  return total;
}
function getCells(s){
  var cells=[];
  /* 钻石形：8行，中间最宽6个，上下收尖，共34个 */
  var rowCounts=[2,4,5,6,6,5,4,2];
  var rows=rowCounts.length;
  var startY=-(rows-1)/2*stepY;
  for(var r=0;r<rows;r++){
    var colsInRow=rowCounts[r];
    var startX=-(colsInRow-1)/2*stepX;
    for(var c=0;c<colsInRow;c++){
      if(cells.length>=total)break;
      var px=startX+c*stepX, py=startY+r*stepY;
      cells.push({row:r,col:c,px:px,py:py,v:0});
    }
    if(cells.length>=total)break;
  }
  return cells;
}

/* 龙虾AgentWorkbuddy六边形SVG - 尖顶 */
function chipSVG(lit,disp,idx){
  var w=Math.round(R*1.8), h=Math.round(R*1.8);
  var cx=w/2, cy=h/2;
  var r=Math.round(R*0.25);
  var pad=Math.round(R*0.08);
  var pinSize=Math.round(R*0.12);
  var pinLen=Math.round(R*0.15);
  
  if(lit){
    var nameSize = Math.max(9, R*0.38);
    var nameY = disp ? cy + nameSize*0.3 : cy;
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" xmlns="http://www.w3.org/2000/svg">'+
      '<defs>'+
        '<linearGradient id="gl'+idx+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FF6B6B"/><stop offset="50%" stop-color="#C83030"/><stop offset="100%" stop-color="#A02020"/></linearGradient>'+
        '<filter id="cg'+idx+'"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>'+
      '</defs>'+
      '<rect x="'+pad+'" y="'+pad+'" width="'+(w-pad*2)+'" height="'+(h-pad*2)+'" rx="'+r+'" fill="none" stroke="rgba(255,107,107,0.3)" stroke-width="4" filter="url(#cg'+idx+')"/>'+
      '<rect x="'+pad+'" y="'+pad+'" width="'+(w-pad*2)+'" height="'+(h-pad*2)+'" rx="'+r+'" fill="url(#gl'+idx+')" stroke="rgba(255,154,118,0.6)" stroke-width="1"/>'+
      '<rect x="'+(pad+R*0.2)+'" y="'+(pad+R*0.2)+'" width="'+(w-pad*2-R*0.4)+'" height="'+(h-pad*2-R*0.4)+'" rx="'+Math.round(r*0.7)+'" fill="none" stroke="rgba(255,154,118,0.3)" stroke-width="0.8"/>'+
      '<circle cx="'+cx+'" cy="'+cy+'" r="'+Math.round(R*0.22)+'" fill="#FF9A76" opacity="0.9"/>'+
      '<circle cx="'+cx+'" cy="'+cy+'" r="'+Math.round(R*0.12)+'" fill="#fff" opacity="0.8"/>'+
      '<rect x="0" y="'+(h*0.25)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      '<rect x="0" y="'+(h*0.5-pinSize/2)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      '<rect x="0" y="'+(h*0.75-pinSize)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.25)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.5-pinSize/2)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.75-pinSize)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="#FF9A76" opacity="0.8"/>'+
      (disp?'<text x="'+cx+'" y="'+Math.round(nameY+R*0.05)+'" text-anchor="middle" font-size="'+nameSize.toFixed(1)+'" fill="#fff" font-weight="800" style="text-shadow:0 1px 3px rgba(0,0,0,0.5)">'+disp+'</text>':'')+
      '</svg>';
  }else{
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" xmlns="http://www.w3.org/2000/svg">'+
      '<defs>'+
        '<linearGradient id="dl'+idx+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(40,60,100,0.8)"/><stop offset="50%" stop-color="rgba(25,40,75,0.85)"/><stop offset="100%" stop-color="rgba(15,25,55,0.9)"/></linearGradient>'+
      '</defs>'+
      '<rect x="'+pad+'" y="'+pad+'" width="'+(w-pad*2)+'" height="'+(h-pad*2)+'" rx="'+r+'" fill="url(#dl'+idx+')" stroke="rgba(100,140,220,0.4)" stroke-width="1.2"/>'+
      '<rect x="'+(pad+R*0.2)+'" y="'+(pad+R*0.2)+'" width="'+(w-pad*2-R*0.4)+'" height="'+(h-pad*2-R*0.4)+'" rx="'+Math.round(r*0.7)+'" fill="none" stroke="rgba(80,120,200,0.25)" stroke-width="0.6"/>'+
      '<circle cx="'+cx+'" cy="'+cy+'" r="'+Math.round(R*0.18)+'" fill="rgba(80,140,220,0.4)"/>'+
      '<rect x="0" y="'+(h*0.25)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '<rect x="0" y="'+(h*0.5-pinSize/2)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '<rect x="0" y="'+(h*0.75-pinSize)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.25)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.5-pinSize/2)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '<rect x="'+(w-pinLen)+'" y="'+(h*0.75-pinSize)+'" width="'+pinLen+'" height="'+pinSize+'" rx="2" fill="rgba(100,140,220,0.5)"/>'+
      '</svg>';
  }
}

/* 昵称显示：中文3字及以内完整显示，英文完整显示，中文4字及以上末字叠字 */
function cuteName(n){
  if(!n)return'';
  var len=n.length;
  /* 检测是否纯英文（含数字和常见符号） */
  var isEnglish=/^[a-zA-Z0-9~!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+$/.test(n);
  if(isEnglish)return n;
  /* 中文3字及以内完整显示 */
  if(len<=3)return n;
  /* 中文4字及以上：最后一个字叠字 */
  return n.charAt(len-1)+n.charAt(len-1);
}

/* 粒子爆发 */
function burstParticles(el){
  var rect=el.getBoundingClientRect();
  var ox=rect.left+rect.width/2, oy=rect.top+rect.height/2;
  var colors=['#C83030','#FF6B6B','#FF6B6B','#FF9A76','#ffffff'];
  for(var i=0;i<12;i++){
    var p=document.createElement('div');p.className='particle';
    var angle=Math.PI*2*i/12, dist=30+Math.random()*25;
    var dx=Math.cos(angle)*dist, dy=Math.sin(angle)*dist;
    var size=2+Math.random()*3;
    p.style.cssText='left:'+ox+'px;top:'+oy+'px;width:'+size+'px;height:'+size+'px;background:'+colors[i%colors.length]+';position:fixed;transition:all 0.6s cubic-bezier(0.25,0.46,0.45,0.94);opacity:1;';
    document.body.appendChild(p);
    (function(el,dx,dy){requestAnimationFrame(function(){el.style.transform='translate('+dx+'px,'+dy+'px)';el.style.opacity='0'})})(p,dx,dy);
    (function(el){setTimeout(function(){el.remove()},700)})(p);
  }
}

function buildGrid(){
  total=parseInt(document.getElementById('totalInput').value)||34;
  total=Math.max(1,Math.min(99,total));
  var scale=findScale();
  var cells=getCells(scale);
  if(cells.length>total){cells.sort(function(a,b){return b.v-a.v});cells=cells.slice(cells.length-total)}
  cells.sort(function(a,b){return a.py!==b.py?a.py-b.py:a.px-b.px});
  total=cells.length;
  document.getElementById('totalInput').value=total;
  var minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  for(var i=0;i<cells.length;i++){
    if(cells[i].px<minX)minX=cells[i].px;if(cells[i].px>maxX)maxX=cells[i].px;
    if(cells[i].py<minY)minY=cells[i].py;if(cells[i].py>maxY)maxY=cells[i].py;
  }
  var offX=-minX+10, offY=-minY+10;
  var gridW=maxX-minX+R*1.9+20, gridH=maxY-minY+R*1.9+20;
  savedCells=cells.slice();savedGridR=R;savedOffX=offX;savedOffY=offY;savedMinX=minX;savedMinY=minY;savedMaxX=maxX;savedMaxY=maxY;
  var grid=document.getElementById('heartGrid');grid.innerHTML='';
  grid.style.width=gridW+'px';grid.style.height=gridH+'px';
  var glow=document.createElement('div');glow.className='heart-glow';grid.appendChild(glow);
  for(var i=0;i<cells.length;i++){
    var isLit=litMap.hasOwnProperty(i), isMine=(myLitIndex===i);
    var el=document.createElement('div');
    var cls='chip';if(isLit)cls+=' lit';else cls+=' available';if(isLit&&!isMine)cls+=' taken';
    el.className=cls;
    el.style.left=(cells[i].px+offX)+'px';el.style.top=(cells[i].py+offY)+'px';
    el.setAttribute('data-index',i);
    el.innerHTML=chipSVG(isLit,isLit?cuteName(litMap[i]):'',i);
    (function(idx){el.onclick=function(){onCellClick(idx)}})(i);
    grid.appendChild(el);
  }
  updateProgress();
}

var _clickLock=false;
function onCellClick(idx){
  if(_clickLock)return;_clickLock=true;setTimeout(function(){_clickLock=false},500);
  /* 管理员模式：按灭 */
  if(adminMode&&litMap.hasOwnProperty(idx)){
    var nm=litMap[idx];if(confirm('按灭 '+nm+' 的模块？')){adminUnlightByName(nm)}return;
  }
  /* 管理员模式：代点亮 */
  if(adminMode&&!litMap.hasOwnProperty(idx)){
    var aname=prompt('代点亮 - 输入学员昵称：');
    if(aname&&aname.trim()){adminLightFor(idx,aname.trim())}return;
  }
  if(myLitIndex>=0){if(myLitIndex===idx)return;showAlready();return}
  if(litMap.hasOwnProperty(idx))return;
  pendingIdx=idx;
  document.getElementById('nameInput').value=myName||'';
  document.getElementById('nameError').style.display='none';
  document.getElementById('nameModal').classList.add('show');
  setTimeout(function(){document.getElementById('nameInput').focus()},100);
}
function confirmName(){
  var name=document.getElementById('nameInput').value.trim(),err=document.getElementById('nameError');
  if(!name){err.textContent='请输入昵称';err.style.display='block';return}
  myName=name;litMap[pendingIdx]=myName;myLitIndex=pendingIdx;saveState();
  document.getElementById('nameModal').classList.remove('show');
  buildGrid();
  var hxs=document.querySelectorAll('.chip');
  for(var i=0;i<hxs.length;i++){
    if(parseInt(hxs[i].getAttribute('data-index'))===pendingIdx){
      hxs[i].classList.add('just-lit');
      burstParticles(hxs[i]);
      (function(el){setTimeout(function(){el.classList.remove('just-lit')},600)})(hxs[i]);
    }
  }
  showSuccess();
  var litCount=0;for(var k in litMap)if(litMap.hasOwnProperty(k))litCount++;
  if(litCount>=total){setTimeout(function(){showCelebration()},1500)}
}
function cancelName(){document.getElementById('nameModal').classList.remove('show');pendingIdx=-1}
document.getElementById('nameInput').addEventListener('keyup',function(e){if(e.key==='Enter')confirmName()});
function showSuccess(){var t=document.getElementById('successToast');t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2200)}
function showAlready(){var t=document.getElementById('alreadyToast');t.classList.add('show');setTimeout(function(){t.classList.remove('show')},1500)}
function showCelebration(){document.getElementById('celebration').classList.add('show')}
function closeCelebration(){document.getElementById('celebration').classList.remove('show')}

function updateProgress(){
  var n=0;for(var k in litMap)if(litMap.hasOwnProperty(k))n++;
  var pct=Math.round(n/total*100);
  document.getElementById('progressNum').innerHTML=n+'<span> / '+total+'</span>';
  document.getElementById('progressBar').style.width=pct+'%';
  var ratio=Math.min(n/total,1);
  var rv=document.querySelector('.robot-img-wrap');
  if(rv)rv.style.filter='drop-shadow(0 0 '+(6+10*ratio)+'px rgba(255,107,107,'+(0.2+0.3*ratio)+'))';
  var gw=document.querySelector('.heart-glow');
  if(gw)gw.style.background='radial-gradient(ellipse,rgba(200,48,48,'+(0.08+0.12*ratio)+') 0%,transparent 70%)';
}

/* ========== 管理员功能 ========== */
var adminOpen=false,adminUnlocked=false;
function tryAdmin(){
  if(adminUnlocked){adminOpen=!adminOpen;document.getElementById('adminPanel').classList.toggle('show',adminOpen);return}
  var pwd=prompt('管理密码：');
  if(pwd==='xiaoxuan2026'){
    adminUnlocked=true;adminMode=true;
    document.querySelector('.admin-fab').textContent='⚙';
    adminOpen=true;
    document.getElementById('adminPanel').classList.add('show');
    loadTitleInputs();
  }else if(pwd!==null){
    alert('密码错误');
  }
}

function adminUnlight(){
  var name=document.getElementById('unlightName').value.trim();
  if(!name){alert('请输入昵称');return}
  adminUnlightByName(name);
}

function adminUnlightByName(name){
  var found=false;
  for(var k in litMap){
    if(litMap[k]===name){
      delete litMap[k];found=true;
      if(myLitIndex===parseInt(k))myLitIndex=-1;
    }
  }
  if(!found){alert('未找到该昵称');return}
  saveState();buildGrid();
  document.getElementById('unlightName').value='';
}

function adminLightFor(idx,name){
  /* 检查昵称是否已存在 */
  for(var k in litMap){
    if(litMap[k]===name){alert('该昵称已点亮');return}
  }
  litMap[idx]=name;
  saveState();buildGrid();
}

function adminRandom(){
  var cnt=Math.floor(total*(0.3+Math.random()*0.4));litMap={};
  var idxs=[];for(var i=0;i<total;i++)idxs.push(i);
  for(var i=idxs.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var tmp=idxs[i];idxs[i]=idxs[j];idxs[j]=tmp}
  var names=['小雨','阿杰','小王','晓晓','大刘','小陈','阿明','小林','晓峰','小赵','阿文','小杨','晓燕','大海','小吴','阿豪','小苏','晓龙','小何','阿飞','小郑','小罗','阿东','小梁','晓华','小韩','阿龙','小周','晓雪','小孙','阿南','小黄','小吕'];
  for(var i=0;i<cnt;i++)litMap[idxs[i]]=names[idxs[i]%names.length];
  myLitIndex=-1;saveState();buildGrid();
}
function adminFull(){
  litMap={};var names=['小雨','阿杰','小王','晓晓','大刘','小陈','阿明','小林','晓峰','小赵','阿文','小杨','晓燕','大海','小吴','阿豪','小苏','晓龙','小何','阿飞','小郑','小罗','阿东','小梁','晓华','小韩','阿龙','小周','晓雪','小孙','阿南','小黄','小吕'];
  for(var i=0;i<total;i++)litMap[i]=names[i%names.length];
  myLitIndex=-1;saveState();buildGrid();
  setTimeout(function(){showCelebration()},800);
}
function adminReset(){
  litMap={};localStorage.removeItem('sc4_data');localStorage.removeItem('sc4_myIdx');
  localStorage.removeItem('sc4_title');localStorage.removeItem('sc4_subtitle');
  myLitIndex=-1;
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  mt.textContent='AI编程课';st.textContent='第4课 龙虾Agent打卡';
  loadTitleInputs();
  buildGrid();
}

function saveTitle(){
  var t=document.getElementById('titleInput').value,st=document.getElementById('subtitleInput').value;
  document.getElementById('mainTitle').textContent=t;
  document.getElementById('subTitle').textContent=st;
  localStorage.setItem('sc4_title',t);
  localStorage.setItem('sc4_subtitle',st);
  // history.replaceState - 移除，避免URL变化影响体验
}

function loadTitleInputs(){
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  document.getElementById('titleInput').value=mt.textContent;
  document.getElementById('subtitleInput').value=st.textContent;
}

function setTitleSize(v){
  document.getElementById('mainTitle').style.fontSize=v+'px';
  document.getElementById('subTitle').style.fontSize=Math.round(v*0.55)+'px';
}

function saveState(){
  localStorage.setItem('sc4_data',JSON.stringify(litMap));
  if(myLitIndex>=0)localStorage.setItem('sc4_myIdx',String(myLitIndex));
  try{
    var base=detectApiBase();
    if(base)syncToServer(base);
  }catch(e){}
}
function detectApiBase(){
  if(location.hostname.indexOf('trycloudflare')>=0||location.hostname==='localhost'||location.hostname==='127.0.0.1'){
    return '/api/lesson/4';
  }
  return 'https://rear-impression-vault-joel.trycloudflare.com/api/lesson/4';
}
var _serverStateLoaded=false;
function loadState(){
  var s=localStorage.getItem('sc4_data');if(s){try{litMap=JSON.parse(s)}catch(e){litMap={}}}
  var mi=localStorage.getItem('sc4_myIdx');if(mi!==null)myLitIndex=parseInt(mi);
  var base=detectApiBase();
  if(base){
    var xhr=new XMLHttpRequest();
    xhr.open('GET',base+'/state',true);
    xhr.onload=function(){
      if(xhr.status===200){
        try{
          var sv=JSON.parse(xhr.responseText);
          if(sv.cells&&Object.keys(sv.cells).length>0){
            var merged={};
            for(var k in sv.cells)merged[k]=sv.cells[k];
            for(var k in litMap){if(!merged[k])merged[k]=litMap[k]}
            litMap=merged;
            localStorage.setItem('sc4_data',JSON.stringify(litMap));
            _serverStateLoaded=true;
            buildGrid();
          }
        }catch(e){}
      }
    };
    xhr.onerror=function(){};
    xhr.send();
  }
}
function syncToServer(base){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',base+'/sync',true);
  xhr.setRequestHeader('Content-Type','application/json');
  xhr.send(JSON.stringify({cells:litMap,order:typeof order!=='undefined'?order:[]}));
}

/* 标题长按编辑 */
(function(){
  var mt=document.getElementById('mainTitle'),st=document.getElementById('subTitle');
  var qp=new URLSearchParams(location.search);
  var smt=qp.get('t')||localStorage.getItem('sc4_title'),sst=qp.get('st')||localStorage.getItem('sc4_subtitle');
  if(smt)mt.textContent=smt;if(sst)st.textContent=sst;
  function bindLongPress(el,key){
    var timer=null;
    el.addEventListener('pointerdown',function(e){
      timer=setTimeout(function(){
        el.contentEditable='true';
        el.style.borderBottomColor='rgba(255,107,107,0.4)';
        el.focus();
        var range=document.createRange();range.selectNodeContents(el);
        var sel=window.getSelection();sel.removeAllRanges();sel.addRange(range);
      },800);
    });
    el.addEventListener('pointerup',function(){clearTimeout(timer)});
    el.addEventListener('pointerleave',function(){clearTimeout(timer)});
    el.addEventListener('blur',function(){
      el.contentEditable='false';
      el.style.borderBottomColor='transparent';
      localStorage.setItem(key,el.textContent);
      var mt2=document.getElementById('mainTitle'),st2=document.getElementById('subTitle');
      // history.replaceState - 移除，避免URL变化
    });
  }
  bindLongPress(mt,'sc4_title');
  bindLongPress(st,'sc4_subtitle');
})();

/* ========== 分享图片生成 ========== */
function _roundRect(ctx,x,y,w,h,r){if(w<2*r)r=w/2;if(h<2*r)r=h/2;ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
function shareImage(){
  try{
  var c=document.createElement('canvas');var W=750,H=1334;c.width=W;c.height=H;var ctx=c.getContext('2d');
  /* 龙虾Agent背景 */
  var grad=ctx.createLinearGradient(0,0,0,H);grad.addColorStop(0,'#1a0e06');grad.addColorStop(0.3,'#2a1508');grad.addColorStop(0.7,'#3a1c0a');grad.addColorStop(1,'#2a1208');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
  /* 余烬光效 */
  function drawEmberShare(yPos,amp,freq,color){
    ctx.beginPath();ctx.moveTo(0,yPos);
    for(var x=0;x<=W;x+=5){ctx.lineTo(x,yPos+Math.sin(x*freq+Date.now()*0.001)*amp)}
    ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();ctx.fillStyle=color;ctx.fill();
  }
  var waterY=H*0.65;
  drawEmberShare(waterY,8,0.008,'rgba(40,100,200,0.12)');
  drawEmberShare(waterY+15,6,0.012,'rgba(60,140,230,0.1)');
  /* 星星 */
  for(var i=0;i<280;i++){ctx.beginPath();ctx.arc(Math.random()*W,Math.random()*H,Math.random()*3+0.5,0,Math.PI*2);ctx.fillStyle='rgba(255,220,180,'+(Math.random()*0.6+0.3)+')';ctx.fill()}
  /* 暗角 */
  var vg=ctx.createRadialGradient(W/2,H/2,200,W/2,H/2,700);vg.addColorStop(0,'transparent');vg.addColorStop(1,'rgba(5,10,30,0.4)');ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  /* 标题 */
  ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='top';ctx.font='bold 52px -apple-system,sans-serif';ctx.fillText(document.getElementById('mainTitle').textContent,W/2,60);
  ctx.font='22px -apple-system,sans-serif';ctx.fillStyle='rgba(255,107,107,0.8)';ctx.fillText(document.getElementById('subTitle').textContent,W/2,125);
  /* 绘制心形格子 - 复用页面buildGrid的布局，保证打卡位置一致 */
  var gridW=savedMaxX-savedMinX+savedGridR*1.8+20,gridH=savedMaxY-savedMinY+savedGridR*1.8+20;
  var bottomStart=H-480;
  var maxGridH=bottomStart-220;
  var sf=Math.min((W-40)/gridW,maxGridH/gridH);
  var cR=savedGridR*sf;
  var marginX=(W-gridW*sf)/2,topY=180;
  /* 心形光晕 */
  var heartCY=topY+gridH*sf/2;
  var hg=ctx.createRadialGradient(W/2,heartCY,30,W/2,heartCY,Math.max(200,gridH*sf*0.5));hg.addColorStop(0,'rgba(200,48,48,0.35)');hg.addColorStop(1,'transparent');ctx.fillStyle=hg;ctx.fillRect(0,150,W,gridH*sf+100);
  for(var i=0;i<savedCells.length;i++){
    var pageCX=savedCells[i].px+savedOffX+savedGridR*0.9;
    var pageCY=savedCells[i].py+savedOffY+savedGridR*0.9;
    var cx2=marginX+pageCX*sf,cy2=topY+pageCY*sf;var isLit=litMap.hasOwnProperty(i);
    var sW=cR*1.7,sH=cR*1.7,sX=cx2-sW/2,sY=cy2-sH/2,sR=cR*0.25;
    var pinW=cR*0.35,pinH=cR*0.18;
    ctx.beginPath();
    ctx.moveTo(sX+sR,sY);ctx.lineTo(sX+sW-sR,sY);ctx.quadraticCurveTo(sX+sW,sY,sX+sW,sY+sR);
    ctx.lineTo(sX+sW,sY+sH-sR);ctx.quadraticCurveTo(sX+sW,sY+sH,sX+sW-sR,sY+sH);
    ctx.lineTo(sX+sR,sY+sH);ctx.quadraticCurveTo(sX,sY+sH,sX,sY+sH-sR);
    ctx.lineTo(sX,sY+sR);ctx.quadraticCurveTo(sX,sY,sX+sR,sY);ctx.closePath();
    if(isLit){
      var g=ctx.createLinearGradient(cx2,cy2-cR,cx2,cy2+cR);g.addColorStop(0,'#FF6B6B');g.addColorStop(0.5,'#C83030');g.addColorStop(1,'#FF9A76');ctx.fillStyle=g;ctx.fill();ctx.strokeStyle='rgba(255,107,107,0.6)';ctx.lineWidth=2;ctx.stroke();
      ctx.fillStyle='rgba(255,154,118,0.75)';
      for(var k=0;k<3;k++){ctx.fillRect(sX-pinW,sY+sH*(0.2+k*0.3)-pinH/2,pinW,pinH)}
      for(var k=0;k<3;k++){ctx.fillRect(sX+sW,sY+sH*(0.2+k*0.3)-pinH/2,pinW,pinH)}
      ctx.beginPath();ctx.arc(cx2,cy2,cR*0.22,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,0.85)';ctx.fill();
      var nm=cuteName(litMap[i]);if(nm){ctx.fillStyle='#fff';ctx.font='bold '+Math.max(10,cR*0.38).toFixed(0)+'px -apple-system,sans-serif';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText(nm,cx2,cy2+sH*0.55)}
    }else{
      var g=ctx.createLinearGradient(cx2,cy2-cR,cx2,cy2+cR);g.addColorStop(0,'rgba(40,60,100,0.8)');g.addColorStop(0.5,'rgba(30,45,75,0.7)');g.addColorStop(1,'rgba(25,35,60,0.6)');ctx.fillStyle=g;ctx.fill();ctx.strokeStyle='rgba(100,140,220,0.4)';ctx.lineWidth=1.5;ctx.stroke();
      ctx.fillStyle='rgba(100,140,220,0.5)';
      for(var k=0;k<3;k++){ctx.fillRect(sX-pinW,sY+sH*(0.2+k*0.3)-pinH/2,pinW,pinH)}
      for(var k=0;k<3;k++){ctx.fillRect(sX+sW,sY+sH*(0.2+k*0.3)-pinH/2,pinW,pinH)}
      ctx.beginPath();ctx.arc(cx2,cy2,cR*0.18,0,Math.PI*2);ctx.fillStyle='rgba(100,140,220,0.4)';ctx.fill();
    }
  }
  /* 机器人 */
  var rH=80;
  var robotImg=document.getElementById('robotImg');if(robotImg&&robotImg.complete&&robotImg.naturalWidth>0){var rW=120,rH2=120*robotImg.naturalHeight/robotImg.naturalWidth,rX=W/2-rW/2,rY=bottomStart-10;ctx.save();ctx.beginPath();ctx.arc(W/2,rY+rH2/2,Math.min(rW,rH2)/2,0,Math.PI*2);ctx.closePath();ctx.clip();ctx.drawImage(robotImg,rX,rY,rW,rH2);ctx.restore();rH=rH2}
  ctx.fillStyle='rgba(255,107,107,0.35)';ctx.font='14px -apple-system,sans-serif';ctx.textAlign='center';ctx.textBaseline='top';ctx.fillText('Workbuddy守护者',W/2,bottomStart+rH+8);
  /* 进度 */
  var n=0;for(var k in litMap)if(litMap.hasOwnProperty(k))n++;
  ctx.fillStyle='rgba(255,255,255,0.5)';ctx.font='16px -apple-system,sans-serif';ctx.fillText('已点亮',W/2,bottomStart+rH+28);
  ctx.fillStyle='#FF6B6B';ctx.font='bold 40px -apple-system,sans-serif';ctx.fillText(n+' / '+total,W/2,bottomStart+rH+62);
  /* 进度条 */
  var barW=260,barH=8,barX=(W-barW)/2,barY=bottomStart+rH+114;ctx.fillStyle='rgba(255,255,255,0.05)';_roundRect(ctx,barX,barY,barW,barH,3);ctx.fill();
  var pct=n/total;if(pct>0){var pg=ctx.createLinearGradient(barX,0,barX+barW*pct,0);pg.addColorStop(0,'#C83030');pg.addColorStop(0.5,'#FF6B6B');pg.addColorStop(1,'#E74C3C');ctx.fillStyle=pg;_roundRect(ctx,barX,barY,barW*pct,barH,3);ctx.fill()}
  /* 二维码 */
  try{
    var pageUrl='https://rear-impression-vault-joel.trycloudflare.com/lesson4.html';
    var qr=qrcode(0,'M');qr.addData(pageUrl);qr.make();var mc=qr.getModuleCount();var qs=3,qm=6,qx=W/2-(mc*qs+qm*2)/2,qy=H-60-(mc*qs+qm*2);
    ctx.fillStyle='rgba(255,255,255,0.95)';_roundRect(ctx,qx-4,qy-4,(mc*qs+qm*2)+8,(mc*qs+qm*2)+8,6);ctx.fill();
    for(var r=0;r<mc;r++)for(var c3=0;c3<mc;c3++){ctx.fillStyle=qr.isDark(r,c3)?'#1a0e06':'#fff';ctx.fillRect(qx+qm+c3*qs,qy+qm+r*qs,qs,qs)}
    ctx.fillStyle='rgba(255,107,107,0.45)';ctx.font='14px -apple-system,sans-serif';ctx.fillText('长按识别二维码 · 开启Agent之旅',W/2,qy-20);
  }catch(e){console.log('qr error',e)}
  var dataUrl=c.toDataURL('image/png');var ov=document.createElement('div');ov.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center';var img=document.createElement('img');img.src=dataUrl;img.style.cssText='max-width:90%;max-height:75vh;border-radius:8px';var tip=document.createElement('div');tip.style.cssText='color:#fff;font-size:16px;margin-top:16px;opacity:0.7';tip.textContent='\u957f\u6309\u56fe\u7247\u4fdd\u5b58 \u2192 \u53d1\u5230\u7fa4\u804a';var btn=document.createElement('button');btn.style.cssText='margin-top:12px;padding:10px 30px;border:none;border-radius:20px;background:linear-gradient(135deg,#FF6B6B,#C83030);color:#000;font-size:16px;font-weight:bold';btn.textContent='\u5173\u95ed';btn.onclick=function(){ov.remove()};ov.appendChild(img);ov.appendChild(tip);ov.appendChild(btn);ov.onclick=function(e){if(e.target===ov)ov.remove()};document.body.appendChild(ov);
  }catch(e){console.error(e);alert("分享图生成失败："+e.message)}
}

loadState();buildGrid();
</script>
</body>
</html>