<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>龙虾Agent打卡 · AI编程训练营</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#1a1210}
#bgCanvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0}
.vignette{position:fixed;inset:0;z-index:1;pointer-events:none;background:radial-gradient(ellipse at center,transparent 50%,rgba(16,8,4,0.4) 100%)}
.scene{position:relative;z-index:2;width:100%;width:100%;height:100vh;height:100dvh;margin:0 auto;display:flex;flex-direction:column;align-items:center;padding:16px 4px 10px}
.header{text-align:center;flex-shrink:0}
.header h1{font-size:20px;font-weight:800;color:#fff;letter-spacing:4px;text-shadow:0 0 20px rgba(255,107,107,0.3)}
.header .sub{font-size:11px;color:rgba(255,107,107,0.4);margin-top:2px;letter-spacing:4px}
.heart-area{flex:1;min-height:0;width:100%;display:flex;align-items:center;justify-content:center;position:relative}
.heart-grid{position:relative;margin:0 auto}
.heart-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:90vw;height:90vw;max-width:400px;max-height:400px;background:radial-gradient(ellipse,rgba(200,48,48,0.08) 0%,transparent 70%);pointer-events:none;z-index:-1}
.robot-section{flex-shrink:0;display:flex;flex-direction:column;align-items:center;margin-top:-8px}
.robot-img-wrap{position:relative;width:130px;height:130px;border-radius:50%;overflow:hidden;filter:drop-shadow(0 0 12px rgba(255,107,107,0.35));-webkit-touch-callout:default;-webkit-user-select:none;user-select:none}.robot-img{width:100%;height:100%;object-fit:contain;-webkit-touch-callout:default;-webkit-user-select:auto;user-select:auto}.robot-guard{position:absolute;inset:0;border-radius:50%;z-index:-1;pointer-events:none}
.robot-label{font-size:8px;color:rgba(255,107,107,0.35);letter-spacing:3px;margin-top:2px}
.bottom-stats{flex-shrink:0;text-align:center;margin-top:6px}
.progress-label{font-size:10px;color:rgba(255,255,255,0.25);margin-bottom:1px;margin-top:12px}
.progress-num{font-size:26px;font-weight:800;color:#FF6B6B;text-shadow:0 0 10px rgba(240,192,64,0.3)}
.progress-num span{font-size:12px;color:rgba(240,192,64,0.6);font-weight:400}
.progress-bar{width:130px;height:2px;background:rgba(255,255,255,0.04);border-radius:2px;overflow:hidden;margin:4px auto 0}
.progress-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,#C83030,#FF6B6B,#E74C3C);transition:width 0.6s}
.progress-tip{font-size:7px;color:rgba(255,255,255,0.06);margin-top:3px;letter-spacing:2px}
.chip{position:absolute;cursor:pointer;transition:transform 0.2s,filter 0.2s}
.chip.available:hover{transform:scale(1.1);filter:brightness(1.4) drop-shadow(0 0 8px rgba(255,107,107,0.5));z-index:10}
.chip.lit{cursor:default}
.chip.taken{cursor:not-allowed;opacity:0.85}
.chip svg{display:block}
@keyframes chipPop{0%{transform:scale(0.3);opacity:0}50%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}
.chip.just-lit{animation:chipPop 0.5s ease-out forwards}
@keyframes breathe{0%,100%{filter:brightness(1) drop-shadow(0 0 0px transparent)}50%{filter:brightness(1.06) drop-shadow(0 0 4px rgba(240,192,64,0.15))}}
.chip.lit{animation:breathe 3s ease-in-out infinite}
@keyframes pulse{0%,100%{filter:brightness(1) drop-shadow(0 0 0px transparent)}50%{filter:brightness(1.15) drop-shadow(0 0 6px rgba(255,107,107,0.2))}}
.chip.available{animation:pulse 2.5s ease-in-out infinite}
/* 粒子层 */
.particle{position:absolute;pointer-events:none;border-radius:50%;z-index:20}
/* 庆祝层 */
.celebration{position:fixed;inset:0;z-index:150;display:none;align-items:center;justify-content:center;background:rgba(16,10,5,0.7);backdrop-filter:blur(4px)}
.celebration.show{display:flex}
.celebration-card{background:linear-gradient(135deg,rgba(30,18,10,0.96),rgba(30,18,10,0.98));border:1px solid rgba(255,107,107,0.2);border-radius:20px;padding:32px 28px;text-align:center;animation:celebPop 0.6s ease-out}
@keyframes swordPop{0%{transform:scale(0) rotate(-45deg);opacity:0}50%{transform:scale(1.3) rotate(10deg);opacity:1}70%{transform:scale(0.9) rotate(-5deg)}100%{transform:scale(1) rotate(0deg);opacity:1}}
@keyframes celebPop{0%{transform:scale(0.5);opacity:0}70%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
.celebration-card .icon{font-size:48px;margin-bottom:8px}
.celebration-card .title{font-size:20px;color:#C83030;font-weight:800;margin-bottom:4px}
.celebration-card .desc{font-size:12px;color:rgba(255,107,107,0.5);margin-bottom:16px}
.celebration-card .close-btn{padding:10px 32px;background:linear-gradient(135deg,#C83030,#FF6B6B);border:none;border-radius:12px;color:#fff;font-size:14px;font-weight:700;cursor:pointer}
.modal-overlay{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;background:rgba(20,12,6,0.88);backdrop-filter:blur(8px)}
.modal-overlay.show{display:flex}
.modal-card{background:linear-gradient(135deg,rgba(30,18,10,0.96),rgba(30,18,10,0.98));border:1px solid rgba(255,107,107,0.12);border-radius:16px;padding:24px 22px;text-align:center;width:270px;animation:modalIn 0.3s ease-out}
@keyframes modalIn{0%{transform:scale(0.8);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-card .label{font-size:14px;color:rgba(255,107,107,0.7);margin-bottom:12px}
.modal-card input{width:100%;padding:12px;background:rgba(30,18,10,0.8);border:1px solid rgba(255,107,107,0.12);border-radius:10px;color:#FF6B6B;font-size:15px;text-align:center;outline:none;font-weight:600}
.modal-card input::placeholder{color:rgba(255,255,255,0.2);font-size:13px}
.modal-card input:focus{border-color:rgba(255,107,107,0.35)}
.modal-card .btns{display:flex;gap:10px;margin-top:12px}
.modal-card .btn-cancel{flex:1;padding:10px 0;background:transparent;border:1px solid rgba(255,255,255,0.06);border-radius:10px;color:rgba(255,255,255,0.2);font-size:13px;cursor:pointer}
.modal-card .btn-ok{flex:1;padding:10px 0;background:linear-gradient(135deg,#C83030,#FF6B6B);border:none;border-radius:10px;color:#fff;font-size:13px;font-weight:700;cursor:pointer}
.modal-card .error{color:#ff5555;font-size:11px;margin-top:6px;display:none}
.toast{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.6);background:rgba(30,18,10,0.96);border:1px solid rgba(255,107,107,0.15);border-radius:18px;padding:28px 36px;text-align:center;z-index:200;opacity:0;transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);pointer-events:none}
.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1);box-shadow:0 0 30px rgba(255,107,107,0.3),0 0 60px rgba(255,107,107,0.1)}
.toast .icon{font-size:48px;margin-bottom:8px;animation:swordPop 0.6s cubic-bezier(0.34,1.56,0.64,1)}
.toast .msg{font-size:16px;color:#FF6B6B;font-weight:700}
.toast .sub{font-size:11px;color:rgba(255,107,107,0.4);margin-top:4px}
.already-toast{position:fixed;top:40%;left:50%;transform:translate(-50%,-50%) scale(0.6);background:rgba(30,18,10,0.92);border:1px solid rgba(255,107,107,0.08);border-radius:12px;padding:14px 22px;text-align:center;z-index:200;opacity:0;transition:all 0.3s;pointer-events:none}
.already-toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.already-toast .msg{font-size:12px;color:rgba(255,107,107,0.5)}
.admin-fab{position:fixed;bottom:12px;right:12px;z-index:50;width:26px;height:26px;border-radius:50%;background:rgba(30,18,10,0.5);border:1px solid rgba(255,107,107,0.06);color:rgba(255,107,107,0.25);font-size:10px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.admin-panel{position:fixed;bottom:44px;right:12px;z-index:50;display:none;gap:6px;align-items:center;background:rgba(30,18,10,0.92);border:1px solid rgba(255,107,107,0.06);border-radius:8px;padding:8px 12px;flex-wrap:wrap;max-width:260px}
.admin-panel.show{display:flex}
.admin-panel label{font-size:9px;color:rgba(255,107,107,0.3)}
.admin-panel input{background:rgba(30,18,10,0.8);border:1px solid rgba(255,107,107,0.08);color:#ccc;padding:3px 6px;border-radius:4px;font-size:9px;width:40px;text-align:center}
.admin-panel button{background:rgba(160,100,30,0.3);border:1px solid rgba(255,107,107,0.08);color:rgba(255,107,107,0.4);padding:4px 8px;border-radius:4px;cursor:pointer;font-size:9px}
.admin-panel button.primary{background:linear-gradient(135deg,#C83030,#FF6B6B);color:#fff;border:none}

.share-btn{position:absolute;top:4px;right:6px;z-index:999;padding:3px 8px;border-radius:10px;background:rgba(240,192,64,0.15);color:rgba(240,192,64,0.7);font-size:10px;font-weight:600;border:1px solid rgba(240,192,64,0.25);cursor:pointer;white-space:nowrap}
.share-btn:active{opacity:0.7}

</style>
